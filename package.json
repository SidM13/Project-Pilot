{
  "name": "projectpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/gen-static-actions.mjs && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "demo:setup": "node --env-file=.env.local scripts/setup-demo.mjs",
    "verify:security": "node --env-file=.env.local scripts/verify-security.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "security:scan": "node scripts/security-scan.mjs --history",
    "build:pages": "node scripts/gen-static-actions.mjs && NEXT_BUILD_TARGET=pages next build && touch out/.nojekyll && node scripts/security-scan.mjs --dir out",
    "preview:pages": "node scripts/serve-pages.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
