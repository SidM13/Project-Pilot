# Data mode: "demo" (default) runs on an in-memory demonstration store — no database needed.
# Set to "supabase" to use the real database (requires migrations; see README).
# PROJECTPILOT_DATA_MODE=demo

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only, used ONLY by scripts/ (never imported by the app).
# Secret key (sb_secret_…). The legacy SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=sb_secret_...
# Supabase → Project Settings → Database → Connection string (URI, session pooler)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Demo workspace (server-only; the browser never sees these)
DEMO_EMAIL=demo@projectpilot.app
DEMO_PASSWORD=change-me-to-a-long-random-string
DEMO_REFERENCE_DATE=2026-11-16

# Stage 4 — Google Gemini (server-only; never prefix with NEXT_PUBLIC_)
# Key: https://aistudio.google.com/apikey · Model ids: https://ai.google.dev/gemini-api/docs/models
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional: 0 disables "thinking" on Flash models (cheaper, faster); leave unset for models that require it.
# GEMINI_THINKING_BUDGET=0
# Optional: fresh model calls allowed per user per hour (cached answers are free). Default 20.
# AI_HOURLY_LIMIT=20
